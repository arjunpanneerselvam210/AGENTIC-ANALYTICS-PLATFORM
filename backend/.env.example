# ==============================================================================
# FreshMart Agentic Analytics Platform - Environment Configuration Template
# Copy this file to .env and adjust credentials for your environment.
# NEVER commit the real .env file with production secrets to version control.
# ==============================================================================

# Application Settings
APP_NAME="Agentic Analytics Platform"
APP_ENV="development"
DEBUG=False
API_V1_PREFIX="/api/v1"

# Security & Authentication (JWT)
# Generate a strong 32+ byte random secret for production deployments
SECRET_KEY="replace-with-a-secure-random-secret-key-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Company Business Database (MySQL)
# Stores FreshMart business data: HRMS, ERP, CRM, Sales, Inventory, Finance
MYSQL_HOST="localhost"
MYSQL_PORT=3306
MYSQL_USER="root"
MYSQL_PASSWORD="your_mysql_password_here"
MYSQL_DB="company_analytics"

# Application Metadata & Auth Database (PostgreSQL)
# Stores users, roles, permissions, role_permissions, audit logs
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_postgres_password_here"
POSTGRES_DB="company_auth"

# Local LLM Engine (Ollama)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_AGENT_MODEL="llama3.1:8b"
OLLAMA_SQL_MODEL="qwen2.5-coder:7b"

# MCP Database Server Configuration (Read-Only)
MCP_SERVER_NAME="freshmart-analytics-mcp"
MCP_MYSQL_USER="freshmart_mcp_reader"
MCP_MYSQL_PASSWORD="McpReaderPassword123!"
MCP_MAX_RESULT_ROWS=1000
MCP_MAX_SQL_LENGTH=10000
MCP_QUERY_TIMEOUT_SECONDS=10
